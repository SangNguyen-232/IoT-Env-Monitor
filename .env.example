# Copy to .env for local use. Set fresh private credentials before starting the services.
# Host Node uses this address. Compose sets the backend to postgres:5432.
DB_HOST=localhost
DB_NAME=iot_db
DB_USER=iot_user
DB_PASS=change-me-db
DB_PORT=5433

# Automatically delete telemetry older than this many days at backend startup
# and every six hours. Set 0 to keep lab data until an explicit cleanup.
# Export/back up experiments before retention expires; monitor disk usage at 0.
SENSOR_RETENTION_DAYS=30

# Express session (long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Generate a device key (for example, openssl rand -hex 32).
# Set it in .env and copy the same value into firmware/include/secrets.h.
SENSOR_API_KEY=

# Created on first boot when system_users is empty
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# Use a connector token for the tunnel. A nonempty placeholder is sufficient for
# the local PostgreSQL and host Node workflow described in GUIDE.md.
CLOUDFLARE_TUNNEL_TOKEN=change-me-tunnel-token
