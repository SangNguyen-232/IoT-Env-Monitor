# Copy to .env inside the Linux Ubuntu virtual machine and set fresh private credentials.
# Host Node tests on the Ubuntu VM connect to 127.0.0.1:5433 (PostgreSQL is never exposed
# on Cloudflare); Docker Compose overrides `iot_backend` to internal `postgres:5432`.
DB_HOST=localhost
DB_NAME=iot_db
DB_USER=iot_user
DB_PASS=change-me-db
DB_PORT=5433

# Automatically delete telemetry older than this many days at backend startup
# and every six hours. Set 0 to keep lab data until an explicit cleanup.
# Export/back up experiments before retention expires; monitor disk usage at 0.
SENSOR_RETENTION_DAYS=30

# Express session (long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Generate a device key on the Ubuntu VM (for example, openssl rand -hex 32).
# Set it in .env and copy the same value into firmware/include/secrets.h.
SENSOR_API_KEY=

# Created on first boot when system_users is empty
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# Connector token for `iot_cloudflared` (tunnel `iot-env-monitor-sys`, `1 VPC` route)
# bridging `http://backend:3000` on the Ubuntu VM to Cloudflare Workers VPC (`iot-env-backend`)
# behind `*.workers.dev` (GUIDE.md section 7). Use a nonempty placeholder such as
# `unused-local` when running only local PostgreSQL + host Node (section 3).
CLOUDFLARE_TUNNEL_TOKEN=change-me-tunnel-token
