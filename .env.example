# PostgreSQL (Docker + Node)
DB_HOST=localhost
DB_NAME=iot_db
DB_USER=iot_user
DB_PASS=change-me-db
DB_PORT=5433

# Express session (long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Shared with ESP32 firmware/include/config/secrets.h
SENSOR_API_KEY=password-api-key

# Created on first boot when system_users is empty
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# Cloudflare Tunnel token
CLOUDFLARE_TUNNEL_TOKEN=change-me-tunnel-token
