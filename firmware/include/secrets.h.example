#pragma once

// Copy this file to firmware/include/secrets.h (gitignored) and set real values.
// For a device upload, replace the AP and HTTP passwords and set SENSOR_API_KEY
// to the key generated in the server's private .env. Firmware images embed these values.

#ifndef SSID_AP
#define SSID_AP "ESP32 LOCAL"
#endif

#ifndef PASS_AP
#define PASS_AP "change-me-ap-password"
#endif

#ifndef DEVICE_HTTP_USER
#define DEVICE_HTTP_USER "admin"
#endif

#ifndef DEVICE_HTTP_PASS
#define DEVICE_HTTP_PASS "change-me-device-http"
#endif

#ifndef SENSOR_API_KEY
#define SENSOR_API_KEY "change-me-sensor-key"
#endif

// Use an origin reachable from the board, such as the host LAN IP and port
// or the deployed gateway URL. A saved LittleFS /server.json takes precedence.
#ifndef SENSOR_API_URL
#define SENSOR_API_URL "https://your-named-tunnel.example"
#endif
