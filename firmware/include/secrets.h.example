#pragma once

// Copy this file to firmware/include/secrets.h (gitignored) inside the Linux Ubuntu VM
// before compiling and flashing locally over USB passthrough (/dev/ttyACM0).
// Firmware and the embedded port-80 dashboard run strictly on the ESP32-S3 / local LAN
// (never deployed onto Cloudflare). Set SENSOR_API_KEY to match .env on the Ubuntu VM.

#ifndef SSID_AP
#define SSID_AP "ESP32 LOCAL"
#endif

#ifndef PASS_AP
#define PASS_AP "change-me-ap-password"
#endif

#ifndef DEVICE_HTTP_USER
#define DEVICE_HTTP_USER "admin"
#endif

#ifndef DEVICE_HTTP_PASS
#define DEVICE_HTTP_PASS "change-me-device-http"
#endif

#ifndef SENSOR_API_KEY
#define SENSOR_API_KEY "change-me-sensor-key"
#endif

// Set to the deployed Cloudflare Worker `*.workers.dev` HTTPS gateway URL (which routes
// POST /sensor via Workers VPC `iot-env-backend` + Cloudflare Tunnel `iot-env-monitor-sys`
// to `iot_backend:3000` on the Ubuntu VM; the tunnel itself has `1 VPC` route and no public
// hostname), or to a bridged Ubuntu VM LAN IP (e.g. http://192.168.1.20:3000). /server.json overrides this.
#ifndef SENSOR_API_URL
#define SENSOR_API_URL "https://iot-env-monitor-sys.your-subdomain.workers.dev"
#endif
